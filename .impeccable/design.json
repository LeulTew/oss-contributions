      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Pull request state\"><button class=\"ds-filter\" type=\"button\" aria-pressed=\"true\">All <span class=\"ds-count\">25</span></button><button class=\"ds-filter\" type=\"button\" aria-pressed=\"false\">Open</button></div>",
      "css": ".ds-filters{display:flex;gap:20px;border-bottom:1px solid var(--line,#dce3dd)}.ds-filter{font-family:\"Segoe UI\",system-ui,-apple-system,BlinkMacSystemFont,sans-serif;line-height:1.5;display:flex;gap:8px;align-items:center;background:none;color:var(--muted,#5d6a62);border:0;border-bottom:2px solid transparent;padding:13px 1px;font-size:.85rem;min-height:48px;cursor:pointer}.ds-filter:hover{color:var(--accent,#215b40)}.ds-filter[aria-pressed=true]{border-bottom-color:var(--accent,#215b40);color:var(--accent,#215b40);font-weight:650}.ds-count{display:inline-block;padding:1px 6px;background:var(--soft,#edf3ee);border-radius:4px;font-size:.73rem;font-weight:500;font-variant-numeric:tabular-nums}.ds-filter[aria-pressed=true] .ds-count{background:var(--selected,#e6f1e9)}.ds-filter:focus-visible{outline:3px solid #648fc5;outline-offset:4px}@media(max-width:650px){.ds-filters{gap:14px}.ds-filter{gap:5px;font-size:.78rem}.ds-count{padding:0 4px}}@media(prefers-reduced-motion:no-preference){.ds-filter{transition:background-color 160ms ease-out,border-color 160ms ease-out,color 160ms ease-out}}"
